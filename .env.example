# Server only. In Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=
# A long random token for first-coach setup. Remove after creating that account.
SETUP_TOKEN=
PORT=3000
# Optional automatic password recovery email. Without these, the Railway owner
# can generate a private link with npm run account:recover.
PUBLIC_APP_URL=
RESEND_API_KEY=
PASSWORD_RESET_FROM=
